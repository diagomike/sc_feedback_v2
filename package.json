{
  "name": "sc-feedback-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4300",
    "build": "prisma generate && next build",
    "start": "next start -p 4300",
    "lint": "next lint",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:integration": "npm run test:db:prepare && vitest run --config vitest.integration.config.ts",
    "test:e2e:smoke": "tsx tests/scripts/run-playwright.ts smoke",
    "test:e2e:full": "tsx tests/scripts/run-playwright.ts full && npm run test:e2e:report",
    "test:e2e:private": "tsx tests/scripts/run-private-e2e.ts",
    "test:e2e:report": "tsx tests/scripts/render-e2e-report.ts",
    "test:db:prepare": "tsx tests/scripts/prepare-test-db.ts",
    "test:fixtures:sanitize": "tsx tests/scripts/sanitize-registry.ts",
    "test:ci": "npm run test:unit && tsc --noEmit --incremental false && npm run test:integration && npm run test:e2e:smoke",
    "test:watch": "vitest",
    "bootstrap": "tsx prisma/bootstrap.ts",
    "registry:convert": "tsx prisma/real-data/convert-erp.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@prisma/client": "6.19.3",
    "@xyflow/react": "^12.11.5",
    "argon2": "^0.40.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "docx": "^9.7.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jszip": "^3.10.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
