// University Lecturer Feedback System — data model (v2)
//
// Ported from the v1 app at D:\py_yaddessa\sc_feedback with one domain change: campaigns
// now belong to a Semester (Fall/Spring/Summer) instead of inferring "which round" from
// closesAt dates. See Semester below for why, and CLAUDE.md for the v1 bugs this removes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum RoleKind {
  ADMIN
  MANAGER
  TEACHER
  STUDENT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  emailLower   String     @unique
  /// The registry's own identifier - a student's ERP id number ("UGR/36321/17"). Nullable
  /// because staff created by hand or by the people CSV have none; unique so re-importing
  /// the same roster updates rather than duplicates.
  externalId   String?    @unique
  name         String
  phone        String?
  passwordHash String?
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles            UserRole[]
  sessions         Session[]
  memberships      Membership[]
  groupMemberships StudentGroupMember[]

  hierarchyNode HierarchyNode?

  offeringsAsTeacher      CourseOffering[]     @relation("OfferingTeacher")
  courseEnrollments       CourseEnrollment[]

  assignmentsAsTeacher    CampaignAssignment[] @relation("AssignmentTeacher")
  assignmentsAsRespondent CampaignAssignment[] @relation("AssignmentRespondent")
  tasksAsTeacher          ResponseTask[]       @relation("TaskTeacher")
  tasksAsRespondent       ResponseTask[]       @relation("TaskRespondent")
  responsesAsTeacher      Response[]           @relation("ResponseTeacher")
  responsesAsRespondent   Response[]           @relation("ResponseRespondent")
  ballotsAsTeacher        Ballot[]             @relation("BallotTeacher")

  @@index([emailLower])
}

model UserRole {
  userId String
  kind   RoleKind
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id              String     @id @default(cuid())
  emailLower      String
  tokenHash       String     @unique
  intendedRole    RoleKind
  hierarchyNodeId String?
  managedByNodeId String?
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime   @default(now())

  @@index([emailLower])
}

// ─────────────────────────────────────────────────────────────────────────
// Hierarchy — a layered DAG (multiple parents allowed), not a tree.
// ─────────────────────────────────────────────────────────────────────────

enum NodeType {
  OFFICE
  COLLEGE
  DEPARTMENT
}

model HierarchyNode {
  id        String   @id @default(cuid())
  name      String
  level     Int
  type      NodeType @default(DEPARTMENT)
  userId    String?  @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  outgoingEdges HierarchyEdge[] @relation("EdgeParent")
  incomingEdges HierarchyEdge[] @relation("EdgeChild")

  closureAsAncestor   HierarchyClosure[] @relation("ClosureAncestor")
  closureAsDescendant HierarchyClosure[] @relation("ClosureDescendant")

  memberships   Membership[]
  studentGroups StudentGroup[]
  courses       Course[]
  likertScales  LikertScale[]
  templates     Template[]
  campaigns     Campaign[]

  @@index([level])
}

model HierarchyEdge {
  parentId String
  childId  String
  parent   HierarchyNode @relation("EdgeParent", fields: [parentId], references: [id], onDelete: Cascade)
  child    HierarchyNode @relation("EdgeChild", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId])
  @@index([childId])
}

model HierarchyClosure {
  ancestorId   String
  descendantId String
  depth        Int
  ancestor     HierarchyNode @relation("ClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant   HierarchyNode @relation("ClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId])
}

// ─────────────────────────────────────────────────────────────────────────
// Personnel and groups
// ─────────────────────────────────────────────────────────────────────────

model Membership {
  userId String
  nodeId String
  kind   RoleKind
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  node   HierarchyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId, kind])
  @@index([nodeId])
}

// A different class schedule (weekend or evening meetings instead of daytime), taught by
// the same teachers as Regular sections. Weekend/Extension have reduced contact hours per
// term, which is why they also run a Summer term (see the Term enum comment) — nothing
// else in the app treats a group differently based on this field.
enum StudentProgram {
  REGULAR
  WEEKEND
  EXTENSION
}

model StudentGroup {
  id        String         @id @default(cuid())
  nodeId    String
  name      String
  program   StudentProgram @default(REGULAR)
  /// The registry's own section coordinates ("Third Year" + "Section 4"). Nullable because
  /// a hand-made group need not be a registry section; together with nodeId they are what a
  /// roster re-import matches on, so loading the same file twice updates one group.
  classYear    String?
  sectionLabel String?
  createdAt DateTime       @default(now())

  node        HierarchyNode        @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  members     StudentGroupMember[]
  assignments CampaignAssignment[]
  offerings   CourseOffering[]

  @@unique([nodeId, classYear, sectionLabel])
  @@index([nodeId])
}

// -------------------------------------------------------------------------
// Courses - who actually taught what, to which section, in which semester.
//
// The ASTU paper form asks for "Course Title and Code" in its header: a student rates a
// teacher FOR A COURSE, not in the abstract. Before this existed a CampaignAssignment could
// only say "these students rate this teacher", so a teacher taking one section for two
// courses collapsed into a single form and no answer knew which course it was about.
//
// A CourseOffering is the unit the registry actually exports (its `course_id` lands in
// externalId), and it is also the authorisation for a cross-department campaign: see
// campaigns.ts - a department may reach another department's section precisely when one of
// its own teachers has an offering against it.
// -------------------------------------------------------------------------

model Course {
  id        String   @id @default(cuid())
  code      String   @unique
  title     String
  /// The department that owns the subject, inferred from the code prefix on import (CSEG ->
  /// Computer Science & Engineering, MATH -> Applied Mathematics, ...). Nullable because a
  /// prefix the map does not know must still import rather than fail the whole file.
  nodeId    String?
  createdAt DateTime @default(now())

  node      HierarchyNode?   @relation(fields: [nodeId], references: [id])
  offerings CourseOffering[]

  @@index([nodeId])
}

model CourseOffering {
  id             String   @id @default(cuid())
  semesterId     String
  courseId       String
  teacherId      String
  studentGroupId String
  /// The registry's own id for this offering. Unique, so re-importing a semester updates
  /// the existing rows instead of duplicating every section.
  externalId     String?  @unique
  createdAt      DateTime @default(now())

  semester     Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher      User         @relation("OfferingTeacher", fields: [teacherId], references: [id])
  studentGroup StudentGroup @relation(fields: [studentGroupId], references: [id], onDelete: Cascade)

  enrollments CourseEnrollment[]
  assignments CampaignAssignment[]
  tasks       ResponseTask[]
  responses   Response[]

  @@unique([semesterId, courseId, teacherId, studentGroupId])
  @@index([semesterId, teacherId])
  @@index([studentGroupId])
}

model CourseEnrollment {
  offeringId String
  userId     String

  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([offeringId, userId])
  @@index([userId])
}

model StudentGroupMember {
  groupId String
  userId  String
  group   StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Templates
// ─────────────────────────────────────────────────────────────────────────

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TargetGroup {
  STUDENT
  PEER
  MANAGER
}

enum SectionType {
  LIKERT_GRID
  FREE_TEXT
}

model LikertScale {
  id          String   @id @default(cuid())
  name        String
  ownerNodeId String?
  createdAt   DateTime @default(now())

  ownerNode HierarchyNode?    @relation(fields: [ownerNodeId], references: [id])
  points    LikertPoint[]
  sections  TemplateSection[]

  @@index([ownerNodeId])
}

model LikertPoint {
  id      String @id @default(cuid())
  scaleId String
  label   String
  value   Int
  order   Int
  scale   LikertScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@index([scaleId])
}

model Template {
  id           String         @id @default(cuid())
  title        String
  targetGroup  TargetGroup
  status       TemplateStatus @default(DRAFT)
  /// The university's official form for this audience. New campaigns attach the three
  /// defaults automatically; a cloned departmental variant is deliberately not a default.
  isDefault    Boolean        @default(false)
  ownerNodeId  String
  clonedFromId String?
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  ownerNode  HierarchyNode     @relation(fields: [ownerNodeId], references: [id])
  clonedFrom Template?         @relation("TemplateClone", fields: [clonedFromId], references: [id])
  clones     Template[]        @relation("TemplateClone")
  sections   TemplateSection[]

  campaignTemplates CampaignTemplate[]
  responseTasks     ResponseTask[]
  responses         Response[]

  @@index([ownerNodeId])
  @@index([status])
}

model TemplateSection {
  id          String      @id @default(cuid())
  templateId  String
  title       String
  description String?
  type        SectionType
  scaleId     String?
  weight      Float       @default(1)
  isOverall   Boolean     @default(false)
  /// The ASTU forms all carry a "not applicable" column ("If the teacher does not apply,
  /// put a check"). An N/A answer stores a null pointValue with notApplicable true, so
  /// scoring.ts skips it exactly as it already skips an unanswered item - it must never be
  /// normalised as if it were the bottom of the scale.
  allowNotApplicable Boolean @default(false)
  order       Int

  template Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  scale    LikertScale?   @relation(fields: [scaleId], references: [id])
  items    TemplateItem[]

  @@index([templateId])
}

model TemplateItem {
  id        String  @id @default(cuid())
  sectionId String
  text      String
  weight    Float   @default(1)
  required  Boolean @default(true)
  order     Int

  section TemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([sectionId])
}

// ─────────────────────────────────────────────────────────────────────────
// Semesters — v2's replacement for v1's date-guessing "which round is this".
//
// v1 inferred a campaign's season from closesAt (month >= 6 meant Fall, else Spring) and
// meant "which round" as "this node's Nth most recent campaign" (an offset skip/take).
// That produced three real bugs (duplicate season labels, a missing round, NULLS-order
// flips across a datasource migration — see CLAUDE.md). A Semester is instead a real,
// admin-managed row shared by the whole university, so every campaign's round is a
// direct foreign key, not a guess.
//
// Declaration order of Term is chronological within an academic year, but startsAt is
// the canonical sort key everywhere — nothing should depend on enum declaration order.
// ─────────────────────────────────────────────────────────────────────────

enum Term {
  FALL
  SPRING
  SUMMER
}

model Semester {
  id           String   @id @default(cuid())
  academicYear Int // start year of the academic year: 2026 renders as "2026/27"
  term         Term
  startsAt     DateTime
  endsAt       DateTime
  active       Boolean  @default(true) // soft-disable, mirrors HierarchyNode.active
  createdAt    DateTime @default(now())

  campaigns Campaign[]
  offerings CourseOffering[]

  @@unique([academicYear, term])
  @@index([startsAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Campaigns
// ─────────────────────────────────────────────────────────────────────────

enum CampaignType {
  EMAIL
  INSTANT
}

enum CampaignStatus {
  DRAFT
  OPEN
  CLOSED
}

enum AudienceMode {
  REGISTERED_ONLY
  GUEST_ALLOWED
}

model Campaign {
  id           String         @id @default(cuid())
  nodeId       String
  semesterId   String
  name         String
  type         CampaignType
  status       CampaignStatus @default(DRAFT)
  audienceMode AudienceMode   @default(REGISTERED_ONLY)
  publicSlug   String?        @unique
  opensAt      DateTime?
  closesAt     DateTime?
  maxResponses Int?
  minResponses Int            @default(5)
  minTeachers  Int            @default(1)
  minStudents  Int            @default(1)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  node     HierarchyNode @relation(fields: [nodeId], references: [id])
  semester Semester      @relation(fields: [semesterId], references: [id])

  campaignTemplates CampaignTemplate[]
  assignments       CampaignAssignment[]
  tasks             ResponseTask[]
  responses         Response[]
  ballots           Ballot[]

  @@index([nodeId])
  @@index([status])
  @@index([semesterId])
}

model CampaignTemplate {
  campaignId  String
  targetGroup TargetGroup
  templateId  String
  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template    Template    @relation(fields: [templateId], references: [id])

  @@id([campaignId, targetGroup])
}

model CampaignAssignment {
  id               String      @id @default(cuid())
  campaignId       String
  teacherId        String
  targetGroup      TargetGroup
  studentGroupId   String?
  courseOfferingId String?
  respondentUserId String?

  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  teacher      User            @relation("AssignmentTeacher", fields: [teacherId], references: [id])
  studentGroup StudentGroup?   @relation(fields: [studentGroupId], references: [id])
  offering     CourseOffering? @relation(fields: [courseOfferingId], references: [id])
  respondent   User?           @relation("AssignmentRespondent", fields: [respondentUserId], references: [id])

  @@index([campaignId, teacherId])
}

model ResponseTask {
  id               String      @id @default(cuid())
  campaignId       String
  teacherId        String
  respondentId     String
  targetGroup      TargetGroup
  templateId       String
  courseOfferingId String?
  /// courseOfferingId as a NON-NULL discriminator, "" when there is no course (peer, head,
  /// guest). Postgres treats NULLs in a unique constraint as distinct, so keying the
  /// constraint on the nullable FK itself would silently stop deduplicating peer and head
  /// tasks - exactly the rows that most need it.
  offeringKey      String      @default("")
  tokenHash        String      @unique
  completedAt      DateTime?
  lastEmailedAt    DateTime?
  createdAt        DateTime    @default(now())

  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  teacher    User            @relation("TaskTeacher", fields: [teacherId], references: [id])
  respondent User            @relation("TaskRespondent", fields: [respondentId], references: [id])
  template   Template        @relation(fields: [templateId], references: [id])
  offering   CourseOffering? @relation(fields: [courseOfferingId], references: [id])

  @@unique([campaignId, teacherId, respondentId, offeringKey])
}

// ─────────────────────────────────────────────────────────────────────────
// Responses
// ─────────────────────────────────────────────────────────────────────────

enum RespondentKind {
  STUDENT
  PEER
  MANAGER
  GUEST
}

model Response {
  id               String         @id @default(cuid())
  campaignId       String
  teacherId        String
  templateId       String
  respondentKind   RespondentKind
  respondentUserId String?
  courseOfferingId String?
  /// See ResponseTask.offeringKey - same non-null discriminator, same reason.
  offeringKey      String         @default("")
  ballotId         String?        @unique
  submittedAt      DateTime       @default(now())
  revokedAt        DateTime?

  campaign   Campaign        @relation(fields: [campaignId], references: [id])
  teacher    User            @relation("ResponseTeacher", fields: [teacherId], references: [id])
  template   Template        @relation(fields: [templateId], references: [id])
  respondent User?           @relation("ResponseRespondent", fields: [respondentUserId], references: [id])
  offering   CourseOffering? @relation(fields: [courseOfferingId], references: [id])
  ballot     Ballot?         @relation(fields: [ballotId], references: [id])
  answers    Answer[]

  @@unique([campaignId, teacherId, respondentUserId, offeringKey])
  @@index([teacherId, campaignId])
  @@index([courseOfferingId])
}

model Answer {
  id            String  @id @default(cuid())
  responseId    String
  itemId        String
  pointValue    Int?
  /// True when the respondent ticked "not applicable". pointValue stays null, so every
  /// existing scoring path already excludes it; this flag exists so a required item can be
  /// satisfied by N/A, and so "how often was this item N/A" stays answerable.
  notApplicable Boolean @default(false)
  text          String?

  response Response     @relation(fields: [responseId], references: [id], onDelete: Cascade)
  item     TemplateItem @relation(fields: [itemId], references: [id])

  @@index([responseId])
  @@index([itemId])
}

model Ballot {
  id         String    @id @default(cuid())
  campaignId String
  teacherId  String
  tokenHash  String    @unique
  consumedAt DateTime?
  ipHash     String?
  createdAt  DateTime  @default(now())

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  teacher  User      @relation("BallotTeacher", fields: [teacherId], references: [id])
  response Response?

  @@index([campaignId, teacherId])
}
